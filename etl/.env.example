# Skill Hunt ETL — Environment Variables
# Copy this file to `.env` and fill in your values.
# ==========================================================

# ==========================================================
# REQUIRED
# ==========================================================

# Supabase PostgreSQL connection string (used by extractor, ingest, transformer)
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI)
SUPABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Adzuna API credentials (existing extractor) — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ==========================================================
# MULTI-SOURCE INGESTION (ingest_sources.py)
# ==========================================================
# The five default remote-jobs sources (RemoteOK, WeWorkRemotely, Arbeitnow,
# Jobicy, Himalayas) need NO keys and run out of the box.
#
# The keyed sources below unlock local Pakistan/India + extra coverage. Each
# source auto-skips (with a log line) until its key is present, so it is safe
# to leave these blank.

# Jooble — LOCAL Pakistan + India postings. Free key: https://jooble.org/api/about
JOOBLE_API_KEY=

# The Muse — works without a key (rate-limited); a free key raises the limit.
# Get one at: https://www.themuse.com/developers/api/v2 (optional)
THEMUSE_API_KEY=

# USAJobs — US federal jobs (disabled by default in sources_config.json).
# Register free at https://developer.usajobs.gov/ — the User-Agent is your email.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-email@example.com

# ==========================================================
# OPTIONAL — Hybrid skill extraction (local GLiNER, no API cost)
# ==========================================================
ENABLE_GLINER=true
GLINER_MODEL=urchade/gliner_medium-v2.1
DISCOVERY_SAMPLE_RATE=0.1
