# Frontend environment variables
# Copy to .env and update values

# Backend API URL
# Development
VITE_API_URL=http://localhost:8000/api/v1

# Production (update with your Render URL)
# VITE_API_URL=https://skill-hunt-api.onrender.com/api/v1

# Supabase Auth (sign-in, Google OAuth, personalized dashboards)
# Supabase dashboard -> Project Settings -> API
#   VITE_SUPABASE_URL      = "Project URL" (https://xxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = "anon" public key (safe to expose in the browser)
# Leave blank to run without auth (the sign-in page shows a setup hint).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
